---
import wordmark from "../assets/wordmark-MONDAYSinit_light.svg";
import logomark from "../assets/logomark-MONDAYSinit_light.svg";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pl" class="scroll-smooth overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Monday InIT - Wydarzenie IT organizowane przez EKA.NET i Kredek na Politechnice Wrocławskiej."
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={logomark.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="m-0 font-body bg-bg-base text-text-main overflow-x-hidden">
    <nav class="fixed top-0 left-0 w-full bg-[#0b1120]/75 backdrop-blur-md z-50 border-b border-white/5 md:block hidden" id="main-nav">
      <div class="flex justify-between items-center h-20 w-full max-w-[1200px] mx-auto px-4 md:px-8">
        <a href="#home" class="flex items-center">
          <img
            src={logomark.src}
            alt="Mondays InIT"
            class="h-12 w-auto"
          />
        </a>
        <ul class="flex list-none gap-8 m-0 p-0" id="nav-links">
          <li><a href="#home" class="font-medium text-base text-text-muted hover:text-text-main transition-colors">Strona Główna</a></li>
          <li><a href="#opis" class="font-medium text-base text-text-muted hover:text-text-main transition-colors">O inicjatywie</a></li>
          <li><a href="#prelekcje" class="font-medium text-base text-text-muted hover:text-text-main transition-colors">Prelekcje</a></li>
          <li><a href="#about" class="font-medium text-base text-text-muted hover:text-text-main transition-colors">Organizatorzy</a></li>
          <li><a href="#partnerzy" class="font-medium text-base text-text-muted hover:text-text-main transition-colors">Partnerzy</a></li>
        </ul>
        <div class="flex items-center gap-6">
          <button class="md:hidden block w-[30px] h-[30px] bg-transparent border-none cursor-pointer p-0 z-50 relative group" aria-label="Toggle menu" id="mobile-menu-btn">
            <span class="w-full h-[2px] bg-text-main rounded-sm transition-all duration-300 block absolute left-0 top-[6px] origin-center"></span>
            <span class="w-full h-[2px] bg-text-main rounded-sm transition-all duration-300 block absolute left-0 top-[14px] origin-center"></span>
            <span class="w-full h-[2px] bg-text-main rounded-sm transition-all duration-300 block absolute left-0 top-[22px] origin-center"></span>
          </button>
        </div>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="bg-[#05080e] pt-16 pb-8 border-t border-white/5 mt-24">
      <div class="w-full max-w-[1200px] mx-auto px-4 md:px-8 text-center">
        <p>
          &copy; {new Date().getFullYear()} Monday InIT. Wszystkie prawa zastrzeżone.
        </p>
        <p class="text-text-muted text-sm mt-4">
          Wydarzenie otwarte dla wszystkich pasjonatów IT, organizowane przez koła naukowe EKA.NET i Kredek działające na Politechnice Wrocławskiej.
        </p>
      </div>
    </footer>

    <script is:inline>
      const menuBtn = document.getElementById("mobile-menu-btn");
      const navLinks = document.getElementById("nav-links");
      const navItems = document.querySelectorAll("#nav-links a");
      const nav = document.getElementById("main-nav");
      
      if (menuBtn && navLinks) {
        nav.classList.remove('hidden');
        nav.classList.add('flex');
        
        menuBtn.addEventListener("click", () => {
          menuBtn.classList.toggle("open");
          navLinks.classList.toggle("active");
          if(navLinks.classList.contains("active")) {
             navLinks.style.display = "flex";
             navLinks.style.flexDirection = "column";
             navLinks.style.position = "absolute";
             navLinks.style.top = "80px";
             navLinks.style.left = "0";
             navLinks.style.width = "100%";
             navLinks.style.background = "rgba(11, 17, 32, 0.95)";
             navLinks.style.padding = "2rem";
             document.body.style.overflow = "hidden";
          } else {
             navLinks.style = "";
             document.body.style.overflow = "";
          }
        });

        navItems.forEach((item) => {
          item.addEventListener("click", () => {
             navLinks.classList.remove("active");
             navLinks.style = "";
             document.body.style.overflow = "";
             menuBtn.classList.remove("open");
          });
        });
      }
      
      if(menuBtn) {
        menuBtn.addEventListener("click", () => {
          const spans = menuBtn.querySelectorAll('span');
          if(navLinks.classList.contains("active")) {
            spans[0].style.transform = 'translateY(8px) rotate(45deg)';
            spans[1].style.opacity = '0';
            spans[2].style.transform = 'translateY(-8px) rotate(-45deg)';
          } else {
            spans[0].style.transform = '';
            spans[1].style.opacity = '1';
            spans[2].style.transform = '';
          }
        });
      }
    </script>
    <style is:global>
      @media (max-width: 768px) {
        #nav-links {
          display: none;
        }
      }
    </style>
  </body>
</html>
