---
const mainCoordinators = [
  {
    name: "Łukasz Czerwiński",
    role: "Koordynator Główny",
    org: "KN Kredek",
    avatarClass: "kredek-avatar",
  },
  {
    name: "Filip Kwiek",
    role: "Koordynator ds. Współpracy Zewnętrznej",
    org: "KN EKA.NET",
    avatarClass: "eka-avatar",
  },
];

const coordinators = [
  { name: "Emilia Morawska", role: "Koordynator ds. Grafiki", org: "KN Kredek", avatarClass: "kredek-avatar" },
  { name: "Oskar Witek", role: "Koordynator ds. Zamówień", org: "KN Kredek", avatarClass: "kredek-avatar" },
  { name: "Michał Puchyr", role: "Koordynator ds. Informatyzacji", org: "KN EKA.NET", avatarClass: "eka-avatar" },
  { name: "Faustyna Olszewska", role: "Koordynator ds. Grafiki", org: "KN EKA.NET", avatarClass: "eka-avatar" },
  { name: "Franciszek Wojnowski", role: "Koordynator ds. Finansów", org: "KN Kredek", avatarClass: "kredek-avatar" },
  { name: "Miłosz Jakóbik", role: "Koordynator ds. Zamówień", org: "KN EKA.NET", avatarClass: "eka-avatar" },
  { name: "Daria Handke", role: "Koordynator ds. Fotorelacji", org: "KN EKA.NET", avatarClass: "eka-avatar" },
  { name: "Nadia Gill", role: "Koordynator", org: "KN Kredek", avatarClass: "kredek-avatar" },
  { name: "Aleksander Żołnowski", role: "Koordynator", org: "KN EKA.NET", avatarClass: "eka-avatar" },
  { name: "Kamil Jasyk", role: "Koordynator", org: "KN Kredek", avatarClass: "kredek-avatar" },
  { name: "Grzegorz Dynak", role: "Koordynator", org: "KN EKA.NET", avatarClass: "eka-avatar" },
];
---

<section id="coordinators" class="bg-transparent relative pb-32">
  <div class="w-full max-w-[1200px] mx-auto px-4 md:px-8">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-8 max-w-[650px] mx-auto mb-14">
      {
        mainCoordinators.map((coordinator) => (
          <div class="bg-slate-900/60 backdrop-blur-md border border-white/5 rounded-[20px] p-5 text-center transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_10px_30px_-10px_rgba(0,0,0,0.5)] hover:border-white/10">
            <div class="info">
              <h3 class="text-xl mb-2 text-text-main font-heading">{coordinator.name}</h3>
              <p class="text-[0.95rem] text-accent m-0 mb-1 font-medium">{coordinator.role}</p>
              <p class="text-[0.85rem] text-text-muted m-0">{coordinator.org}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-8 max-w-[1000px] mx-auto">
      {
        coordinators.map((coordinator) => (
          <div class="bg-slate-900/60 backdrop-blur-md border border-white/5 rounded-[20px] p-5 text-center transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_10px_30px_-10px_rgba(0,0,0,0.5)] hover:border-white/10">
            <div class="info">
              <h3 class="text-xl mb-2 text-text-main font-heading">{coordinator.name}</h3>
              <p class="text-[0.95rem] text-accent m-0 mb-1 font-medium">{coordinator.role}</p>
              <p class="text-[0.85rem] text-text-muted m-0">{coordinator.org}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
