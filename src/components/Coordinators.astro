---
const coordinators = [
  {
    name: "Osoba z EKA.NET",
    role: "Koordynator / EKA.NET",
    avatarClass: "eka-avatar",
  },
  {
    name: "Osoba z EKA.NET",
    role: "Koordynator / EKA.NET",
    avatarClass: "eka-avatar",
  },
  {
    name: "Osoba z Kredek",
    role: "Koordynator / Kredek",
    avatarClass: "kredek-avatar",
  },
  {
    name: "Osoba z Kredek",
    role: "Koordynator / Kredek",
    avatarClass: "kredek-avatar",
  },
];
---

<section id="coordinators" class="coordinators-section">
  <div class="container">
    <h2 class="section-title">Koordynatorzy</h2>
    <div class="coordinators-grid">
      {
        coordinators.map((coordinator) => (
          <div class="coordinator-card">
            <div class={`avatar ${coordinator.avatarClass}`} />
            <div class="info">
              <h3>{coordinator.name}</h3>
              <p>{coordinator.role}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .coordinators-section {
    background-color: transparent;
    position: relative;
    padding-bottom: 8rem;
  }

  .coordinators-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .coordinator-card {
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    padding: 2rem;
    text-align: center;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .coordinator-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    margin: 0 auto 1.5rem;
    background: var(--surface-color-light);
    position: relative;
  }

  .eka-avatar::after {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: linear-gradient(135deg, #578bfa, #1d4ed8);
    z-index: -1;
  }

  .kredek-avatar::after {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: linear-gradient(135deg, #e98a0e, #f72703);
    z-index: -1;
  }

  .info h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--text-main);
  }

  .info p {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
  }
</style>
