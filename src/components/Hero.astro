---
import logomark from "../assets/logomark-MONDAYSinit_light.svg";
import wordmark from "../assets/wordmark-MONDAYSinit_light.svg";
---

<section id="home" class="hero">
  <div class="hero-bg"></div>
  <div class="container hero-content">
    <h1 class="hero-logo-container">
      <img
        src={wordmark.src}
        alt="Mondays InIT Wordmark"
        class="hero-wordmark"
      />
    </h1>
    <p class="hero-subtitle">
      Początek tygodnia z IT – inicjatywa Kół Naukowych EKA.NET i Kredek.
    </p>
    <div class="hero-details">
      <div class="detail-item">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line
            x1="16"
            y1="2"
            x2="16"
            y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line
            x1="3"
            y1="10"
            x2="21"
            y2="10"></line></svg
        >
        <span>Start: 11 Maja 2026, co każdy poniedziałek</span>
      </div>
      <div class="detail-item">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><circle cx="12" cy="12" r="10"></circle><polyline
            points="12 6 12 12 16 14"></polyline></svg
        >
        <span>18:00 - 20:00</span>
      </div>
      <div class="detail-item">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
          ></path><circle cx="12" cy="10" r="3"></circle></svg
        >
        <span>s. D1.2 C-16 PWr / Zdalnie (w zależności od terminu)</span>
      </div>
    </div>
    <div
      class="hero-actions"
      style="flex-direction: column; align-items: center; gap: 1rem;"
    >
      <div
        style="display: flex; gap: 1.5rem; flex-wrap: wrap; justify-content: center;"
      >
        <a
          href="https://l.facebook.com/l.php?u=https%3A%2F%2Fforms.gle%2FdAu999W1aNc4PZRW6%3Ffbclid%3DIwZXh0bgNhZW0CMTAAYnJpZBEwSTN5bkdOeVMxUmR4bllJT3NydGMGYXBwX2lkEDIyMjAzOTE3ODgyMDA4OTIAAR4OL2cotVwig8geOWOmbnI7W8-hI93FHc1Tj6crFBnPbELrOVUXjhwvXl1AQA_aem_qxxfLcM4GDkgC4o_1HkSqQ&h=AUBu_McxICEGp_aEfeaq8vV-V6vkOB6Ry3sxPApruhRpeqiVB6blzWatVcZ3yQlE26GcPdUEQBbjBL4ilqYw7WiQIimkAX837RbRAECKjjED913gBav4iTjCXkN6rBA"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary">Zapisy na Maj</a
        >
        <a
          href="#"
          style="opacity: 0.5; cursor: not-allowed;"
          class="btn-primary">Zapisy na Czerwiec - wkrótce</a
        >
      </div>
      <a href="#prelekcje" class="btn-outline" style="margin-top: 0.5rem;"
        >Nadchodzące prelekcje</a
      >
    </div>
  </div>
</section>
