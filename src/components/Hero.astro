---
import logomark from "../assets/logomark-MONDAYSinit_light.svg";
import wordmark from "../assets/wordmark-MONDAYSinit_light.svg";
---

<section id="home" class="hero">
  <div class="hero-bg"></div>
  <div class="container hero-content">
    <h1 class="hero-logo-container">
      <img
        src={logomark.src}
        alt="Mondays InIT Logomark"
        class="hero-logomark-inline"
      />
      <img
        src={wordmark.src}
        alt="Mondays InIT Wordmark"
        class="hero-wordmark"
      />
    </h1>
    <p class="hero-subtitle">
      Początek tygodnia z IT – inicjatywa Kół Naukowych EKA.NET i Kredek.
    </p>
    <div class="hero-details">
      <div class="detail-item">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line
            x1="16"
            y1="2"
            x2="16"
            y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line
            x1="3"
            y1="10"
            x2="21"
            y2="10"></line></svg
        >
        <span>Start: 11 Maja 2026, co każdy poniedziałek</span>
      </div>
      <div class="detail-item">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><circle cx="12" cy="12" r="10"></circle><polyline
            points="12 6 12 12 16 14"></polyline></svg
        >
        <span>18:00 - 20:00</span>
      </div>
      <div class="detail-item">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
          ></path><circle cx="12" cy="10" r="3"></circle></svg
        >
        <span>Politechnika Wrocławska</span>
      </div>
    </div>
    <div class="hero-actions">
      <a href="#register" class="btn-primary">Zarejestruj się</a>
      <a href="#prelekcje" class="btn-outline">Nadchodzące prelekcje</a>
    </div>
  </div>
</section>
