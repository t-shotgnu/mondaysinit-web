---
import logomark from "../assets/logomark-MONDAYSinit_light.svg";
import wordmark from "../assets/wordmark-MONDAYSinit_light.svg";
---

<section
  id="home"
  class="min-h-screen flex items-center justify-center pt-20 relative overflow-hidden pb-24"
>
  <div
    class="absolute top-0 left-0 w-full h-full [background:radial-gradient(circle_at_50%_50%,rgba(14,165,233,0.15)_0%,rgba(11,17,32,0)_70%)] [mask-image:linear-gradient(to_bottom,black_50%,transparent_100%)] -z-10"
  >
  </div>
  <div class="w-full max-w-[1200px] mx-auto px-4 md:px-8 text-center z-10">
    <h1
      class="flex items-center justify-center gap-6 mb-8 w-full max-w-[80%] mx-auto md:max-w-none"
    >
      <img
        src={wordmark.src}
        alt="Mondays InIT Wordmark"
        class="h-[clamp(60px,15vw,240px)] w-auto object-contain drop-shadow-[0_0_20px_rgba(14,165,233,0.2)] md:mx-4 w-full"
      />
    </h1>
    <p class="text-xl text-text-muted mx-auto mb-12 font-normal max-w-[800px]">
      Początek tygodnia z IT – cykl warsztatów Kół Naukowych EKA.NET i Kredek.
    </p>
    <div
      class="flex justify-center flex-wrap gap-4 md:gap-8 mx-auto mb-12 max-w-[800px] flex-col md:flex-row items-center"
    >
      <div class="flex items-center gap-3 text-lg text-slate-300">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-monday-yellow"
          ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line
            x1="16"
            y1="2"
            x2="16"
            y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line
            x1="3"
            y1="10"
            x2="21"
            y2="10"></line></svg
        >
        <span>Co Poniedziałek, od 11 Maja do 15 Czerwca 2026</span>
      </div>
      <div class="flex items-center gap-3 text-lg text-slate-300">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-monday-yellow"
          ><circle cx="12" cy="12" r="10"></circle><polyline
            points="12 6 12 12 16 14"></polyline></svg
        >
        <span>18:00 - 20:00</span>
      </div>
      <div class="flex items-center gap-3 text-lg text-slate-300">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-monday-yellow"
          ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
          ></path><circle cx="12" cy="10" r="3"></circle></svg
        >
        <span>s. D1.2 C-16 PWr / Zdalnie (w zależności od terminu)</span>
      </div>
    </div>
    <div class="flex flex-col items-center gap-4 px-4 w-full">
      <div class="flex flex-col items-center gap-3 w-full max-w-[600px] mx-auto">
        <div class="flex items-center gap-3 bg-emerald-500/10 border border-emerald-500/30 rounded-2xl px-8 py-5 shadow-[0_4px_30px_rgba(16,185,129,0.15)] w-full justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400 shrink-0">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          <div class="text-left">
            <p class="text-emerald-400 font-bold text-lg leading-tight">Cykl MONDAYSinIT dobiegł końca!</p>
            <p class="text-slate-400 text-sm mt-0.5">Dziękujemy wszystkim uczestnikom i prelegentom 🙌</p>
          </div>
        </div>
        <a
          href="#prelekcje"
          class="bg-transparent text-white px-8 py-3 rounded-full text-base font-semibold border-2 border-monday-yellow transition-all duration-300 min-w-[200px] max-w-[400px] whitespace-nowrap hover:bg-monday-yellow hover:text-[#0b1120] w-full md:w-auto mx-auto flex justify-center items-center"
        >
          Zobacz wszystkie prelekcje
        </a>
      </div>
      <a
        href="https://www.facebook.com/events/1283605063242178/1283605076575510"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex justify-center items-center gap-2 bg-[#1877f2]/20 border border-[#1877f2]/50 text-white px-8 py-3 rounded-full text-base font-semibold hover:bg-[#1877f2]/30 transition-all duration-300 min-w-[200px] max-w-[400px] whitespace-nowrap w-full md:w-auto mx-auto md:mx-0 mt-2"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="#1877f2"
          ><path
            d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
          ></path></svg
        >
        Wydarzenie na Facebooku
      </a>
    </div>
  </div>
</section>
