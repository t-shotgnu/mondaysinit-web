---
import dolnySlaskBanner from "../assets/dolny_slask_wsparcie.svg";
---

<section id="wsparcie" class="funding-section container">
  <div class="funding-container">
    <img
      src={dolnySlaskBanner.src}
      alt="Dofinansowano ze środków Samorządu Województwa Dolnośląskiego"
      class="funding-banner"
    />
  </div>
</section>

<style>
  .funding-section {
    text-align: center;
    padding: 1rem 1rem 6rem;
  }
  .funding-container {
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 24px;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 1000px;
    margin: 0 auto;
  }
  .funding-banner {
    width: 100%;
    max-width: 800px;
    height: auto;
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    .funding-container {
      padding: 0.5rem;
    }
  }
</style>
