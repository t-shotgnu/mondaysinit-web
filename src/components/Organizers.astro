---
import ekaLogo from "../assets/eka_net_logo.svg";
import kredekLogo from "../assets/kredek_logo.svg";
import GlassCard from "./GlassCard.astro";
import Typography from "./Typography.astro";

const SOCIAL_STYLES = {
  webiste: {
    iconColor: "text-white",
    bgColor: "bg-white/10 hover:bg-white/20",
    textColor: "text-slate-200",
    icon: "<path d=\"M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z\"/><path d=\"M2 12h20M12 2v20\"/>",
    label: "Strona internetowa"
  },
  facebook: {
    iconColor: "text-blue-400",
    bgColor: "bg-white/10 hover:bg-white/20",
    textColor: "text-slate-200",
    icon: `<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>`,
    label: "Facebook"
  },
  linkedin: {
    iconColor: "text-blue-400",
    bgColor: "bg-white/10 hover:bg-white/20",
    textColor: "text-slate-200",
    icon: `<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>`,
    label: "LinkedIn"
  },
  email: {
    iconColor: "text-monday-yellow",
    bgColor: "bg-monday-yellow/10 hover:bg-monday-yellow/20 border border-monday-yellow/20",
    textColor: "text-monday-yellow",
    icon: `<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline>`,
    label: "" // For email we usually want the address as label
  }
} as const;

const organizers = [
  {
    name: "KN EKA.NET",
    logo: ekaLogo,
    description: `Jesteśmy społecznością zrzeszającą pasjonatów programowania z Wydziału Informatyki i Telekomunikacji. Naszym celem jest zgłębianie tajników ekosystemu Microsoft, ze szczególnym uwzględnieniem technologii .NET. Łączymy teorię z praktyką – regularnie organizujemy merytoryczne spotkania, hackathony i warsztaty, które pomagają studentom stawiać pierwsze kroki w świecie komercyjnego IT.`,
    gradient: "before:from-[#578bfa] before:to-[#1d4ed8]",
    socials: [
      { platform: "webiste", url: "https://www.ekadotnet.pwr.edu.pl/" },
      { platform: "facebook", url: "https://www.facebook.com/ekadotnet" },
      { platform: "email", url: "mailto:ekadotnet@outlook.com", customLabel: "ekadotnet@outlook.com" }
    ]
  },
  {
    name: "KN Kredek",
    logo: kredekLogo,
    description: `Działamy na Wydziale Informatyki i Telekomunikacji jako inicjatywa tworzona przez studentów dla studentów. Wykraczamy poza ramy standardowego programu zajęć, promując kulturę dzielenia się wiedzą. Organizujemy otwarte prelekcje i warsztaty poruszające szerokie spektrum tematów – od inżynierii oprogramowania po najnowsze trendy w świecie technologii. Tworzymy przestrzeń do networkingu i wspólnego rozwoju.`,
    gradient: "before:from-[#e98a0e] before:to-[#f72703]",
    socials: [
      { platform: "webiste", url: "https://kredek.dce.pwr.edu.pl" },
      { platform: "facebook", url: "https://www.instagram.com/kn_kredek/" },
      { platform: "email", url: "mailto:knkredek+mondaysinit@gmail.com", customLabel: "knkredek+mondaysinit@gmail.com" }
    ]
  }
];
---

<section id="about" class="py-24 bg-transparent relative">
  <div class="w-full max-w-[1200px] mx-auto px-4 md:px-8">
    <Typography variant="h2" class="mb-16">Organizatorzy</Typography>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      {organizers.map((org) => (
        <GlassCard class={`p-8 md:p-12 relative overflow-hidden transition-all duration-300 before:absolute before:top-0 before:left-0 before:w-full before:h-1 before:bg-gradient-to-r ${org.gradient}`}>
          <img src={org.logo.src} alt={`${org.name} Logo`} class="h-12 max-w-full object-contain mb-6" />
          <Typography variant="body">
            {org.description}
          </Typography>
          
          <div class="flex flex-wrap gap-3 mt-6">
            {org.socials.map((social) => {
              const style = SOCIAL_STYLES[social.platform as keyof typeof SOCIAL_STYLES];
              return (
                <a 
                  href={social.url} 
                  target={social.platform !== 'email' ? "_blank" : undefined}
                  rel={social.platform !== 'email' ? "noopener noreferrer" : undefined}
                  class={`flex items-center gap-2 px-4 py-2 rounded-full transition-all duration-200 text-sm font-medium no-underline ${style.bgColor} ${style.textColor}`}
                >
                  <svg 
                    width="16" 
                    height="16" 
                    viewBox="0 0 24 24" 
                    fill={social.platform === 'email' ? 'none' : 'currentColor'} 
                    stroke={social.platform === 'email' ? 'currentColor' : 'none'}
                    stroke-width={social.platform === 'email' ? '2' : '0'}
                    stroke-linecap="round" 
                    stroke-linejoin="round"
                    class={style.iconColor}
                    set:html={style.icon}
                  />
                  {social.customLabel || style.label}
                </a>
              );
            })}
          </div>
        </GlassCard>
      ))}
    </div>

    <!-- Sekcja Dostępności -->
    <div class="mt-12 max-w-full">
      <GlassCard class="p-6 md:p-8 relative overflow-hidden transition-all duration-300 border border-white/5 hover:border-white/10 before:absolute before:left-0 before:top-0 before:bottom-0 before:w-1.5 before:bg-monday-yellow">
        <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
          <div class="p-4 bg-monday-yellow/10 rounded-2xl text-monday-yellow shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-accessibility">
              <circle cx="12" cy="5" r="1" />
              <path d="m9 20 3-6 3 6" />
              <path d="m6 8 6 2 6-2" />
              <path d="M12 10v4" />
            </svg>
          </div>
          <div class="text-center md:text-left flex-grow">
            <Typography variant="h4" class="mb-2 !text-monday-yellow font-bold text-lg">Dostępność wydarzenia</Typography>
            <Typography variant="body" class="text-[0.95rem] leading-relaxed text-text-muted">
              W celu zapewnienia dostępności osobom ze szczególnymi potrzebami organizator umożliwia zgłoszenie potrzeb związanych z udziałem w wydarzeniu.
              Prosimy o przekazanie informacji o wymaganych udogodnieniach poprzez kontakt z organizatorem z należytym wyprzedzeniem pod adresem: 
              <a href="mailto:knkredek+mondaysinit@gmail.com" class="text-monday-yellow hover:text-white underline transition-colors font-semibold">knkredek+mondaysinit@gmail.com</a>.
            </Typography>
          </div>
        </div>
      </GlassCard>
    </div>
  </div>
</section>
